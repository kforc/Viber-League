# Dependencies — installed, never committed
node_modules/

# Vite build output — regenerated by `npm run build` / `npm run bundle`
dist/

# macOS noise
.DS_Store

# Logs
*.log

# Screenshot output — regenerated by `npm run shots`, `npm run shots:portrait`,
# `npm run sheet` and the `tools/cdp/probe-*.mjs` harnesses. These were committed
# once and cost ~32 MB of working tree and ~113 MB of history: every re-shoot
# committed a fresh set of incompressible PNGs. The handful worth showing live in
# `docs/media/`, which is committed on purpose.
docs/screens/
docs/screens-*/
docs/brand-pitch/
docs/viber-league-*.png

# Agent working notes (project memory) and WorkBuddy app artifacts. Kept on disk,
# deliberately not published.
.workbuddy-ai/
.workbuddy/
.wbapp_*

# The publish directory: `Viber-League.html` copied to `index.html` so the
# published page IS the verifiable artifact, byte for byte. Regenerated at deploy
# time, never edited.
site/
